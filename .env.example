# Terminal 3 (T3N) Enterprise Agent Configuration
#
# Copy to .env and fill in. .env is git-ignored — never commit a real key.
#
# Claim a key at https://www.terminal3.io/claim-page (self-serve, instant).
T3N_API_KEY=0x_your_t3n_api_key_here

# Cluster to target. "testnet" while building; switch to "production" to go live.
T3N_ENVIRONMENT=testnet
